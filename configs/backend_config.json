      "name": "vllm-8001",
      "_gpu": "GPU 0,1",
      "api_base": "http://127.0.0.1:8001/v1/chat/completions",
      "model": "Qwen3.8-27B",
      "api_key": "local-pool-key",
      "concurrency": 64,
      "weight": 1,
      "extra_body": {
        "chat_template_kwargs": {
          "enable_thinking": false
        }
