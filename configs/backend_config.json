{
  "_comment": "本机 4 个 vLLM 实例，TP=2 各占两张卡。model 是实例的 --served-model-name（问一句就知道: curl -H 'Authorization: Bearer local-pool-key' http://127.0.0.1:8001/v1/models），api_key 等于启动脚本的 --api-key，concurrency 对齐 --max-num-seqs 64——客户端线程超过它只会在服务端排队。实例的 max_model_len 是 8192，长文档多图样本可能撞上限，表现为 failed.jsonl 里堆 content 为空。",
  "request_timeout": 300,
  "max_retries": 2,
  "disable_backend_after_failures": 20,
  "backends": [
    {
      "name": "vllm-8001",
      "_gpu": "GPU 0,1",
      "api_base": "http://127.0.0.1:8001/v1/chat/completions",
      "model": "Qwen3.8-27B",
      "api_key": "local-pool-key",
      "concurrency": 64,
      "weight": 1,
      "extra_body": {
        "chat_template_kwargs": {
          "enable_thinking": false
        }
      }
    },
    {
      "name": "vllm-8002",
      "_gpu": "GPU 2,3",
      "api_base": "http://127.0.0.1:8002/v1/chat/completions",
      "model": "Qwen3.8-27B",
      "api_key": "local-pool-key",
      "concurrency": 64,
      "weight": 1,
      "extra_body": {
        "chat_template_kwargs": {
          "enable_thinking": false
        }
      }
    },
    {
      "name": "vllm-8003",
      "_gpu": "GPU 4,5",
      "api_base": "http://127.0.0.1:8003/v1/chat/completions",
      "model": "Qwen3.8-27B",
      "api_key": "local-pool-key",
      "concurrency": 64,
      "weight": 1,
      "extra_body": {
        "chat_template_kwargs": {
          "enable_thinking": false
        }
      }
    },
    {
      "name": "vllm-8004",
      "_gpu": "GPU 6,7",
      "api_base": "http://127.0.0.1:8004/v1/chat/completions",
      "model": "Qwen3.8-27B",
      "api_key": "local-pool-key",
      "concurrency": 64,
      "weight": 1,
      "extra_body": {
        "chat_template_kwargs": {
          "enable_thinking": false
        }
      }
    }
  ]
}
