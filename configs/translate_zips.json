{
  "dataset_registry": "configs/datasets.json",
  "datasets": [
    "*"
  ],
  "output_jsonl": "output/train.jsonl",
  "chinese_ratio": 1.0,
  "seed": 42,
  "limit_per_dataset": 100,
  "backend_config": "configs/backend_config.json",
  "sample_prompt_file": "prompts/translate_sample_zh.txt",
  "utterance_prompt_file": "prompts/translate_utterance_zh.txt",
  "emit_raw": true,
  "resume": true,
  "mysql": {
    "host": "127.0.0.1",
    "port": 3306,
    "user": "fv",
    "password": "${FV_MYSQL_PASSWORD}",
    "database": "finevision",
    "batch_size": 200,
    "flush_interval_seconds": 5,
    "claim_ttl_seconds": 3600,
    "on_connect_error": "fail",
    "store_conversations": true,
    "_store_conversations_note": "存英文原文。关掉的话账本只有 id/图片路径/状态，省几 GB，但英文那部分样本 db-export 导不出来（源文本不在库里），库就当不成动态配比的唯一数据源。这个开关不能事后补：关着跑完的行不会回填。",
    "pool_size": 8
  }
}
